{
  "multipart": [
    {
      "apply": {
        "model": "cottagecraft:block/chain_silver"
      },
      "when": {
        "axis": "y"
      }
    },
    {
      "apply": {
        "model": "cottagecraft:block/chain_horizontal_silver"
      },
      "when": {
        "axis": "z"
      }
    },
    {
      "apply": {
        "model": "cottagecraft:block/chain_horizontal_silver",
        "y": 90
      },
      "when": {
        "axis": "x"
      }
    },
    {
      "apply": {
        "model": "cottagecraft:block/chain_dangle_silver"
      },
      "when": {
        "axis": "z",
        "dangle": "true"
      }
    },
    {
      "apply": {
        "model": "cottagecraft:block/chain_dangle_silver",
        "y": 90
      },
      "when": {
        "axis": "x",
        "dangle": "true"
      }
    }
  ]
}